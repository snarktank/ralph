# Ralph Codex loop environment for Linux Mint.
# Copy to: ~/.config/ralph-codex/ralph.env

# Target project root that contains the git repository to edit.
PROJECT_ROOT="$HOME/projects/my-app"

# Directory containing ralph.sh, CODEX.md, and prd.json.
RALPH_DIR="$PROJECT_ROOT/scripts/ralph"

# Max Ralph loop iterations per run.
RALPH_ITERATIONS=50

# Codex CLI executable.
CODEX_BIN=codex

# Optional Codex settings.
# RALPH_MODEL=gpt-5.4
# RALPH_PROFILE=default
# RALPH_CODEX_FLAGS="--search"

# Runner behavior.
RALPH_MAX_RETRIES=3
RALPH_MAX_STORY_FAILURES=3
RALPH_RETRY_BASE_SECONDS=10
RALPH_SLEEP_SECONDS=3
RALPH_REQUIRE_CLEAN=0

# Clash mixed port. The user-provided port is 7897.
RALPH_PROXY_HOST=127.0.0.1
RALPH_PROXY_PORT=7897
RALPH_HTTP_PROXY=http://127.0.0.1:7897
RALPH_ALL_PROXY=socks5h://127.0.0.1:7897
RALPH_NO_PROXY=localhost,127.0.0.1,::1

# LAN remote access settings used by setup-remote-access.sh and remote-status.sh.
RALPH_REMOTE_SSH_PORT=22
# Prefer the Windows client IP when only your own two machines are on the LAN.
# RALPH_REMOTE_ALLOW_FROM=192.168.1.10
# RALPH_REMOTE_LAN_CIDR=192.168.1.0/24
# RALPH_REMOTE_WEB_PORTS="5173 3000"
# RALPH_REMOTE_ENABLE_UFW=1
