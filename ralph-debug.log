2026-03-22 00:00:25 - start - {"type":"create_file","path":"parse_stats.sh","content":"#!/bin/bash\n\n# Check if jq is available\nif ! command -v jq &> /dev/null; then\n    echo \"Error: jq is required but not installed\" >&2\n    exit 1\nfi\n\n# Check if prd.json exists\nif [ ! -f \"prd.json\" ]; then\n    echo \"Error: prd.json not found\" >&2\n    exit 1\nfi\n\n# Parse prd.json and count stories\nTOTAL=$(jq '.stories | length' prd.json)\nPASSED=$(jq '[.stories[] | select(.passes == true)] | length' prd.json)\nFAILED=$(jq '[.stories[] | select(.passes == false)] | length' prd.json)\n\n# Output the required format\necho \"Stories: $TOTAL total, $PASSED passed, $FAILED failed\""} - false
