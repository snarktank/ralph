2026-03-21 22:35:56 - end - {"oldString":"# Log action to ralph-debug.log\nlog_action() {\n    local action_type=\"$1\"\n    local action_details=\"$2\"\n    local success=\"$3\"\n    local timestamp=$(date '+%Y-%m-%d %H:%M:%S')\n    echo \"$timestamp - $action_type - $action_details - $success\" >> \"$LOG_FILE\"\n}","newString":"# Log action to ralph-debug.log\nlog_action() {\n    local action_type=\"$1\"\n    local action_details=\"$2\"\n    local success=\"$3\"\n    local duration=\"$4\"\n    local timestamp=$(date '+%Y-%m-%d %H:%M:%S')\n    if [[ -n \"$duration\" ]]; then\n        echo \"$timestamp - $action_type - $action_details - $success - ${duration}s\" >> \"$LOG_FILE\"\n    else\n        echo \"$timestamp - $action_type - $action_details - $success\" >> \"$LOG_FILE\"\n    fi\n}"} - false
