"./ralph.sh\" ]]; then\n mkdir -p \"$SCRIPT_DIR/.staging\"\n if [[ ! -f \"$SCRIPT_DIR/.staging/ralph.sh\" ]]; then\n cp \"$SCRIPT_DIR/ralph.sh\" \"$SCRIPT_DIR/.staging/ralph.sh\"\n debug_log \"Created staging copy of ralph.sh\"\n fi\n path=\"$SCRIPT_DIR/.staging/ralph.sh\"\n debug_log \"Editing staging copy (not live code)\"\n fi\n # Apply each change\n local change_count=0\n echo \"$changes\" | jq -c '.[]' | while read -r change; do\n local old_str new_str old_str=$(echo \"$change\" | jq -r '.oldString // empty')\n new_str=$(echo \"$change\" | jq -r '.newString // empty')\n if [[ -n \"$old_str\" && -n \"$new_str\" && -f \"$path\" ]]; then\n _EP=\"$path\" _EO=\"$old_str\" _EN=\"$new_str\" python3 -c \"import os;p=os.environ['_EP'];c=open(p).read().replace(os.environ['_EO'],os.environ['_EN'],1);open(p,'w').write(c)\"\n ((change_count++))\n else\n debug_log \"Skipping invalid change in $path\"\n fi\n done\n status_line \"$iter\" \"$max_iter\" \"edit_file\" \"$path\" \"OK\" \"$(echo \"$changes\" | jq length) changes\"\n ;;\n \"create_file\")\n local path path=$(echo \"$action\" | jq -r '.path // .filename // empty')\n local content content=$(echo \"$action\" | jq -r '.content // empty')\n if [[ -z \"$path\" ]]; then\n status_line \"$iter\" \"$max_iter\" \"create_file\" \"$path\" \"FAILED\" \"Missing path\"\n continue\n fi\n if [[ -z \"$content\" ]]; then\n status_line \"$iter\" \"$max_iter\" \"create_file\" \"$path\" \"FAILED\" \"Missing content\"\n continue\n fi\n # Create directory if needed\n mkdir -p \"$(dirname \"$path\")\"\n # Write content to file\n echo \"$content\" > \"$path\"\n local size=$(stat -c%s \"$path\" 2>/dev/null || echo \"0\")\n status_line \"$iter\" \"$max_iter\" \"create_file\" \"$path\" \"OK\" \"${size}B\"\n ;;\n \"run_command\")\n local command expect_success command=$(echo \"$action\" | jq -r '.command // empty')\n expect_success=$(echo \"$action\" | jq -r '.expects_success // true')\n if [[ -n \"$command\" ]]; then\n debug_log \"Running: $command\"\n local output output=$(eval \"$command\" 2>&1)\n local exit_code=$?\n if [[ \"$expect_success\" == \"true\" && $exit_code -ne 0 ]]; then\n status_line \"$iter\" \"$max_iter\" \"run_command\" \"$command\" \"FAILED\" \"exit $exit_code\"\n else\n status_line \"$iter\" \"$max_iter\" \"run_command\" \"$command\" \"OK\"\n fi\n fi\n ;;\n \"finish\")\n # SANDBOX: validate staged ralph.sh before accepting\n if [[ -f \"$SCRIPT_DIR/.staging/ralph.sh\" ]]; then\n debug_log \"Validating staged ralph.sh with bash -n...\"\n local _sandbox_err _sandbox_err=$(bash -n \"$SCRIPT_DIR/.staging/ralph.sh\" 2>&1)\n if [[ $? -eq 0 ]]; then\n debug_log \"Syntax OK — applying changes to live ralph.sh\"\n cp \"$SCRIPT_DIR/.staging/ralph.sh\" \"$SCRIPT_DIR/ralph.sh\"\n rm -rf \"$SCRIPT_DIR/.staging\"\n else\n debug_log \"SYNTAX ERROR — changes REJECTED\"\n debug_log \"Error: $_sandbox_err\"\n rm -rf \"$SCRIPT_DIR/.staging\"\n status_line \"$iter\" \"$max_iter\" \"finish\" \"ralph.sh\" \"FAILED\" \"syntax error\"\n continue\n fi\n fi\n _sid=$(jq -r '[.userStories[] | select(.passes == false)][0].id // empty' \"$SCRIPT_DIR/prd.json\" 2>/dev/null)\n if [[ -n \"$_sid\" && \"$_sid\" != \"null\" ]]; then\n _tmp=$(mktemp)\n jq --arg id \"$_sid\" '(.userStories[] | select(.id == $id)).passes = true' \"$SCRIPT_DIR/prd.json\" > \"$_tmp\" && mv \"$_tmp\" \"$SCRIPT_DIR/prd.json\"\n status_line \"$iter\" \"$max_iter\" \"finish\" \"story $_sid\" \"OK\" \"marked as PASSED\"\n fi\n status_line \"$iter\" \"$max_iter\" \"finish\" \"all tasks\" \"OK\" \"complete\"\n return 0\n ;;\n *)\n status_line \"$iter\" \"$max_iter\" \"unknown\" \"$type\" \"FAILED\" \"Unknown action type\"\n ;;\n esac\n done < <(echo \"$actions_json\" | jq -c '.actions[]')\n log_action \"end\" \"execute_nvidia_actions\" \"true\"\n echo \"$action_count\""}]} - false
